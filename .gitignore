# ==========================================
# Large Model Weights (DO NOT PUSH TO GITHUB)
# GitHub blocks files > 100MB; MODELS is ~31GB
# ==========================================
MODELS/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.ckpt

# ==========================================
# Node / Frontend Dependencies & Build Output
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Python Bytecode & Environments
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Local Generation Outputs & Testing Images
# ==========================================
MODEL SERVER/outputs/*
!MODEL SERVER/outputs/.gitkeep

# ==========================================
# Graphify Local Cost, Cache & Backups
# ==========================================
graphify-out/cost.json
graphify-out/cache/
graphify-out/202*

# ==========================================
# Agent / Claude Clones with Nested Git Repos
# ==========================================
.agent/
.agents/
.claude/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.log

# ==========================================
# OS / IDE Artifacts
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
